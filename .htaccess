# Hariyo: always fetch the newest service worker and app shell
<FilesMatch "^(sw\.js|index\.html|manifest\.webmanifest)$">
  Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "\.(woff2|png|webp)$">
  Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
AddType application/manifest+json .webmanifest
# Hide build/server files on plain hosting
<FilesMatch "^(server\.js|package\.json|README\.md)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git
